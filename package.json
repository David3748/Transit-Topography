{
  "name": "transit-topography",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:data": "node scripts/validate-data-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routing": "node scripts/test-routing-graph.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,js,json}\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,js,json}\" \"index.html\"",
    "build": "npm run validate:data && npm run test:routing && npm run test && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.8",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.35",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
